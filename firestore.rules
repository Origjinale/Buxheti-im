rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId &&
             data.amount is number && data.amount > 0 && data.amount < 1000000000 &&
             data.type in ['EXPENSE', 'INCOME'] &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 300)) &&
             data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('paymentMethod' in data) || data.paymentMethod == null || data.paymentMethod in ['CASH', 'CARD', 'TRANSFER']) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidBudget(data, userId) {
      return data.userId == userId &&
             data.monthlyBudget is number && data.monthlyBudget >= 0 && data.monthlyBudget < 1000000000 &&
             data.dailyBudget is number && data.dailyBudget >= 0 && data.dailyBudget < 1000000000 &&
             data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);

      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         incoming().keys().hasAll(['userId', 'amount', 'type', 'category', 'date', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'amount', 'type', 'category', 'note', 'date', 'paymentMethod', 'createdAt', 'updatedAt']) &&
                         isValidTransaction(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTransaction(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'type', 'category', 'note', 'date', 'paymentMethod', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      match /budget/{budgetId} {
        allow get: if isOwner(userId) && isValidId(budgetId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(budgetId) &&
                         incoming().keys().hasAll(['userId', 'monthlyBudget', 'dailyBudget', 'currency', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'monthlyBudget', 'dailyBudget', 'currency', 'createdAt', 'updatedAt']) &&
                         isValidBudget(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(budgetId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidBudget(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['monthlyBudget', 'dailyBudget', 'currency', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(budgetId);
      }
    }
  }
}
